#!/usr/bin/env bash
# Select Nix products, then verify and publish the canonical host command.
set -u
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)" || exit 1
source "$repo_root/build-support/config.bash"
source "$repo_root/build-support/matrix.bash"
source "$repo_root/build-support/driver.bash"

for argument in "$@"; do
	case "$argument" in
		canonize)
			[[ "${1:-}" == canonize ]] || { printf 'canonize cannot be combined with build flags\n' >&2; exit 1; }
			pb_build_main "$repo_root" '' "$@"
			exit "$?"
			;;
		-h|--help|help) pb_build_usage; exit 0 ;;
	esac
done

# Reject a malformed selection before realizing the build environment.
registry=()
registry_text="$(pb_matrix_registry "$repo_root/build-support/implementations")" || exit 1
while IFS= read -r implementation; do registry+=("$implementation"); done <<< "$registry_text"
pb_read_canonical "$repo_root/CANONICAL_IMPL" "${registry[@]}" >/dev/null || exit 1

command=(nix develop "$repo_root#build" --command timeout 1800 bash "$repo_root/build-support/build-driver" "$repo_root" "$@")
command -v nix >/dev/null 2>&1 || { printf './build requires Nix. Install Nix with flakes enabled, then rerun ./build.\n' >&2; exit 1; }
if command -v build-budget >/dev/null 2>&1 && [[ -r /proc/self/cgroup ]]; then
	cgroup="$(</proc/self/cgroup)"
	if [[ "$cgroup" != *'/agentbuilds.slice/'* ]]; then
		exec build-budget --project printable_binary -- timeout 1800 "${command[@]}"
	fi
fi
exec "${command[@]}"
