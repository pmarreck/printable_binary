#!/usr/bin/env bash
# Independent build regressions share a bounded scheduler, never mutable state.
set -u
while IFS= builtin read -r inherited_function; do
	builtin unset -f -- "$inherited_function" || exit 1
done < <(builtin compgen -A function)
if [[ -z "${NIX_BUILD_TOP:-}${TEST_WORKSPACE:-}" ]]; then
	printf 'FAIL: run build regressions through ./test or run-isolated\n' >&2
	exit 1
fi
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)" || exit 1
source "$repo_root/tests/cli/group-runner.bash"
if [[ -v PB_TEST_JOBS ]]; then
	jobs=$PB_TEST_JOBS
else
	jobs=${NIX_BUILD_CORES:-8}
	[[ "$jobs" =~ ^[0-9]+$ ]] || exit 2
	if [[ "${#jobs}" -gt 1 || "$jobs" == 0 || "$jobs" == 9 ]]; then jobs=8; fi
fi
programs=(
	unit/test-build-config unit/test-test-entrypoint unit/test-source-availability
	unit/test-raw-alphabet unit/test-benchmark-entrypoint unit/test-build-matrix
	integration/test-build-publication integration/test-build-driver
	integration/test-native-c-graph integration/test-output-ignore
	integration/test-benchmark-products unit/test-build-all-alias
)
groups=()
declare -A program_by_group=()
for program in "${programs[@]}"; do
	name=${program##*/}
	name=${name//-/_}
	groups+=("$name")
	program_by_group[$name]=$program
done
suite_scratch="$(mktemp -d)" || exit 1
trap 'rm -rf -- "$suite_scratch"' EXIT
run_build_regression() {
	local group_root
	group_root="$(mktemp -d "$suite_scratch/$1.XXXXXXXX")" || return 1
	export HOME="$group_root/home" TMPDIR="$group_root/tmp"
	export XDG_CONFIG_HOME="$group_root/config" XDG_DATA_HOME="$group_root/data"
	export XDG_STATE_HOME="$group_root/state" XDG_CACHE_HOME="$group_root/cache"
	export XDG_RUNTIME_DIR="$group_root/runtime"
	mkdir -p "$HOME" "$TMPDIR" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" \
		"$XDG_STATE_HOME" "$XDG_CACHE_HOME" "$XDG_RUNTIME_DIR" || return 1
	"$BASH" "$repo_root/tests/${program_by_group[$1]}"
}
pb_run_test_groups "$jobs" "$suite_scratch" run_build_regression "${groups[@]}"
