#!/usr/bin/env bash
# Build configuration and the one-way build-all alias contract.

set -u

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
bash "$repo_root/tests/unit/test-build-config" || exit "$?"
bash "$repo_root/tests/unit/test-test-entrypoint" || exit "$?"
bash "$repo_root/tests/unit/test-source-availability" || exit "$?"
bash "$repo_root/tests/unit/test-raw-alphabet" || exit "$?"
bash "$repo_root/tests/unit/test-build-matrix" || exit "$?"
bash "$repo_root/tests/integration/test-build-publication" || exit "$?"
bash "$repo_root/tests/integration/test-build-driver" || exit "$?"
bash "$repo_root/tests/integration/test-native-c-graph" || exit "$?"
bash "$repo_root/tests/integration/test-output-ignore" || exit "$?"
bash "$repo_root/tests/integration/test-benchmark-products" || exit "$?"
test_root="$(mktemp -d)" || exit 1
trap 'rm -rf "$test_root"' EXIT

cp "$repo_root/build-all" "$test_root/build-all" || exit 1
cp "$repo_root/tests/fixtures/record-build-command" "$test_root/build" || exit 1
chmod +x "$test_root/build-all" "$test_root/build" || exit 1
export TEST_COMMAND_LOG="$test_root/arguments"

if bash "$test_root/build-all" --debug && cmp -s "$TEST_COMMAND_LOG" <(printf '%s\0' --all-impls --debug); then
	printf 'PASS: build-all delegates to the complete host implementation scope and preserves flags\n'
	exit 0
fi

printf 'FAIL: build-all did not preserve its scope and arguments\n' >&2
exit 1
