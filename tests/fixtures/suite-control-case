#!/usr/bin/env bash
# Record real control-suite argv before a selected process failure.
set -u
name=${0##*/}
case "$name:$#" in test-shared-suite-failure:1|test-cli-group-runner:0|test-cli-case-inventory:0|test-runtime-runner:0|test-build-suite-driver:0|test-build-prepared-driver:0) ;; *) exit 23 ;; esac
printf '%s\0' "$#" "$@" >> "${SUITE_CONTROL_CALLS:?}/$name" || exit 1
if [[ "$name" == "${SUITE_CONTROL_FAIL:-}" ]]; then
	printf 'controlled %s failure\n' "$name" >&2
	exit 7
fi
