#!/usr/bin/env bash
# The same three outer groups run during Nix validation and fresh confinement.
set -u
if [[ -z "${NIX_BUILD_TOP:-}${TEST_WORKSPACE:-}" ]]; then
	printf 'FAIL: run retained Rust checks through ./test or run-isolated\n' >&2
	exit 1
fi
if [[ "$#" != 1 && "$#" != 3 ]]; then
	printf 'Usage: test-retained-rust ARTIFACT_ROOT [SOURCE_METADATA PACKAGE_METADATA]\n' >&2
	exit 2
fi
artifact_root=$1
source_metadata=${2:-$artifact_root/share/rust-test-targets.json}
package_metadata=${3:-$artifact_root/packaged/share/rust-test-targets.json}
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)" || exit 1
cd "$repo_root" || exit 1
failures=0
node tests/unit/test-rust-test-export.mjs || failures=1
node tests/integration/test-rust-prepared.mjs "$artifact_root" "$source_metadata" source || failures=1
node tests/integration/test-rust-prepared.mjs "$artifact_root/packaged" "$package_metadata" package || failures=1
exit "$failures"
