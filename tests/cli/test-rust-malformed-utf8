#!/usr/bin/env bash
# Invalid/truncated input must not alias a valid glyph through masked bytes.
set -u
binary="${1:?Usage: test-rust-malformed-utf8 PREPARED_RUST_CLI}"
scratch="$(mktemp -d)" || exit 1
trap 'rm -rf -- "$scratch"' EXIT
for input in $'\x82\xb6' $'\xa2\xb6' $'\xc2\x36' $'\xe2\xb6'; do
	printf '%s' "$input" > "$scratch/input"
	PRINTABLE_BINARY_MUTE_STATS=1 "$binary" -d < "$scratch/input" > "$scratch/actual" 2> "$scratch/stderr"
	status=$?
	if [[ "$status" != 1 ]] || ! cmp -s "$scratch/input" "$scratch/actual" || ! grep -q 'input_offset=0' "$scratch/stderr"; then
		printf 'FAIL: Rust decoder changed unrecognized or truncated UTF-8 bytes (%q)\n' "$input" >&2
		exit 1
	fi
done
printf 'PASS: Rust decoder preserves unrecognized and truncated UTF-8\n'
