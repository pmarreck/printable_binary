#!/usr/bin/env bash
# Runtime fixture preparation counts as execution; project compilation is in Nix.
set -u
if [[ -z "${NIX_BUILD_TOP:-}${TEST_WORKSPACE:-}" ]]; then
	printf 'FAIL: run Elixir checks through ./test or run-isolated\n' >&2
	exit 1
fi
artifact_root=${1:?prepared Elixir artifact root}
reference_cli=${2:?prepared Zig reference}
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)" || exit 1
scratch="$(mktemp -d)" || exit 1
trap 'rm -rf -- "$scratch"' EXIT
luajit -e 'for byte=0,255 do io.write(string.char(byte)) end' > "$scratch/allbytes" || exit 1
luajit "$repo_root/utils/prng" --seed 42 --bytes 8192 > "$scratch/random" || exit 1
(cd "$repo_root/utils" && luajit prng --seed 42 --bytes 8192) > "$scratch/random-again" || exit 1
cmp "$scratch/random" "$scratch/random-again" || exit 1
[[ "$(wc -c < "$scratch/allbytes")" == 256 && "$(wc -c < "$scratch/random")" == 8192 ]] || exit 1
for fixture in allbytes random; do
	env -u PRINTABLE_BINARY_MAP PRINTABLE_BINARY_MUTE_STATS=1 "$reference_cli" < "$scratch/$fixture" \
		> "$scratch/$fixture.encoded" 2> "$scratch/reference.err"
	status=$?
	if [[ "$status" != 0 || -s "$scratch/reference.err" ]]; then
		printf 'FAIL: independent Zig fixture encoding\n' >&2
		cat "$scratch/reference.err" >&2
		exit 1
	fi
done
ELIXIR_ERL_OPTIONS='+fnu +S 2:2' elixir -pa "$artifact_root/lib/elixir-app" -pa "$artifact_root/lib/elixir-tests" \
	-e 'PrintableBinary.PreparedTests.run(System.argv())' -- \
	"$scratch/allbytes.encoded" "$scratch/allbytes" "$scratch/random.encoded" "$scratch/random"
