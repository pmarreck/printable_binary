#!/usr/bin/env bash
# Keep the pre-parallel control inventory, exact argv and every failed child.
set -u
if [[ -z "${NIX_BUILD_TOP:-}${TEST_WORKSPACE:-}" ]]; then exit 1; fi
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)" || exit 1
scratch="$(mktemp -d)" || exit 1
trap 'rm -rf -- "$scratch"' EXIT
project="$scratch/project with spaces"
mkdir -p "$project/tests/cli" "$project/tests/unit" "$project/tests/integration" || exit 1
cp "$repo_root/tests/cli/test-suite-controls" "$repo_root/tests/cli/group-runner.bash" "$project/tests/cli/" || exit 1
suites=(test-cli-group-runner test-cli-case-inventory test-runtime-runner test-build-suite-driver test-build-prepared-driver test-shared-suite-failure)
for suite in "${suites[@]}"; do
	if [[ "$suite" == test-shared-suite-failure ]]; then directory=integration; else directory=unit; fi
	ln -s "$repo_root/tests/fixtures/suite-control-case" "$project/tests/$directory/$suite" || exit 1
done
printf '%s\n' "${suites[@]}" | LC_ALL=C sort > "$scratch/expected" || exit 1
legacy_cli="$scratch/legacy cli with spaces"
failures=0
for failed_suite in '' "${suites[@]}"; do
	export SUITE_CONTROL_CALLS="$scratch/calls-${failed_suite:-none}"
	mkdir "$SUITE_CONTROL_CALLS" || exit 1
	SUITE_CONTROL_FAIL="$failed_suite" PB_TEST_JOBS=2 "$BASH" "$project/tests/cli/test-suite-controls" "$legacy_cli" > "$scratch/stdout" 2> "$scratch/stderr"
	status=$?
	if [[ ( -z "$failed_suite" && ( "$status" != 0 || -s "$scratch/stderr" ) ) ||
		( -n "$failed_suite" && ( "$status" == 0 || "$(<"$scratch/stderr")" != *"controlled $failed_suite failure"* ) ) ]] ||
		! cmp -s "$scratch/expected" <(LC_ALL=C ls "$SUITE_CONTROL_CALLS"); then
		printf 'FAIL: runner controls lost work or status for %s\n' "${failed_suite:-positive control}" >&2
		failures=1
	fi
	for suite in "${suites[@]}"; do
		if [[ "$suite" == test-shared-suite-failure ]]; then
			cmp -s "$SUITE_CONTROL_CALLS/$suite" <(printf '%s\0' 1 "$legacy_cli") || failures=1
		else
			cmp -s "$SUITE_CONTROL_CALLS/$suite" <(printf '%s\0' 0) || failures=1
		fi
	done
done
[[ "$failures" == 0 ]] || exit 1
printf 'PASS: all six runner-control suites execute with exact argv and failure propagation\n'
