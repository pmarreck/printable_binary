#!/usr/bin/env bash
# The pre-parallel build inventory must run once even when any one case fails.
set -u
if [[ -z "${NIX_BUILD_TOP:-}${TEST_WORKSPACE:-}" ]]; then exit 1; fi
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)" || exit 1
scratch="$(mktemp -d)" || exit 1
trap 'rm -rf -- "$scratch"' EXIT
project="$scratch/project with spaces"
mkdir -p "$project/tests/unit" "$project/tests/integration" "$project/tests/fixtures" "$project/tests/cli" || exit 1
cp "$repo_root/tests/test_build_all" "$project/tests/test_build_all" || exit 1
cp "$repo_root/tests/cli/group-runner.bash" "$project/tests/cli/group-runner.bash" || exit 1
cp "$repo_root/build-all" "$project/build-all" || exit 1
ln -s "$repo_root/tests/fixtures/build-suite-case" "$project/tests/fixtures/record-build-command" || exit 1
programs=(
	unit/test-build-config unit/test-test-entrypoint unit/test-source-availability
	unit/test-raw-alphabet unit/test-benchmark-entrypoint unit/test-build-matrix
	integration/test-build-publication integration/test-build-driver
	integration/test-native-c-graph integration/test-output-ignore
	integration/test-benchmark-products unit/test-build-all-alias
)
names=()
for program in "${programs[@]}"; do
	ln -s "$repo_root/tests/fixtures/build-suite-case" "$project/tests/$program" || exit 1
	name=${program##*/}
	[[ "$name" != test-build-all-alias ]] || name=legacy_alias
	names+=("$name")
done
printf '%s\n' "${names[@]}" | LC_ALL=C sort > "$scratch/expected" || exit 1
failures=0
for failed_case in '' "${names[@]}"; do
	export BUILD_SUITE_CALLS="$scratch/calls-${failed_case:-none}"
	mkdir "$BUILD_SUITE_CALLS" || exit 1
	BUILD_SUITE_FAIL="$failed_case" PB_TEST_JOBS=2 bash "$project/tests/test_build_all" > "$scratch/stdout" 2> "$scratch/stderr"
	status=$?
	if [[ ( -z "$failed_case" && ( "$status" != 0 || -s "$scratch/stderr" ) ) ||
		( -n "$failed_case" && ( "$status" == 0 || "$(<"$scratch/stderr")" != *"controlled $failed_case failure"* ) ) ]] ||
		! cmp -s "$scratch/expected" <(LC_ALL=C ls "$BUILD_SUITE_CALLS"); then
		printf 'FAIL: build-suite driver lost work or status for %s\n' "${failed_case:-positive control}" >&2
		if [[ -z "$failed_case" ]]; then cat "$scratch/stderr" >&2; fi
		failures=1
	fi
	for name in "${names[@]}"; do
		[[ -f "$BUILD_SUITE_CALLS/$name" ]] && [[ "$(<"$BUILD_SUITE_CALLS/$name")" == "$name" ]] || failures=1
	done
done
[[ "$failures" == 0 ]] || exit 1
printf 'PASS: build-suite inventory executes once and preserves every selected failure\n'
