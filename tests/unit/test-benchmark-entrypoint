#!/usr/bin/env bash
# The benchmark frontend prepares pinned artifacts before fresh measurements.
set -u
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)" || exit 1
if [[ ! -f "$repo_root/bm" || ! -x "$repo_root/bm" ]]; then
	printf 'FAIL: ./bm must be an executable Bash entrypoint, not a directory\n' >&2
	exit 1
fi
scratch="$(mktemp -d)" || exit 1
trap 'rm -rf -- "$scratch"' EXIT
project="$scratch/project with spaces"
mkdir -p "$project" "$scratch/tools" || exit 1
cp "$repo_root/bm" "$project/bm" || exit 1
ln -s "$repo_root/tests/fixtures/record-build-command" "$scratch/tools/nix" || exit 1
ln -s "$repo_root/tests/fixtures/profile-uname" "$scratch/tools/uname" || exit 1
export TEST_COMMAND_LOG="$scratch/arguments" TEST_COMMAND_STATUS=7
export PATH="$scratch/tools:$PATH"
if bash "$project/bm" --help > "$scratch/stdout" 2> "$scratch/stderr"; then
	if [[ -e "$TEST_COMMAND_LOG" ]] || ! grep -q 'recognition' "$scratch/stdout"; then
		printf 'FAIL: benchmark help must describe the experiment without entering Nix\n' >&2; exit 1
	fi
else
	printf 'FAIL: benchmark help must succeed\n' >&2; exit 1
fi
# Confinement exposes no build service; replace the optional admission adapter.
ln -s "$repo_root/tests/fixtures/record-build-command" "$scratch/tools/build-budget" || exit 1
bash "$project/bm" --seed 23 > "$scratch/stdout" 2> "$scratch/stderr"
status=$?
if [[ "$status" != 7 ]] || ! cmp -s "$TEST_COMMAND_LOG" <(printf '%s\0' --project printable_binary -- nix develop "$project#profiling" -c bash "$project/build-support/profile-run" --seed 23); then
	printf 'FAIL: benchmark preparation must use the pinned profiling shell and preserve failure status\n' >&2; exit 1
fi
printf 'PASS: benchmark entrypoint help, pinned preparation, spaces, and failure propagation\n'
TEST_UNAME=Darwin bash "$project/bm" --seed 23 > "$scratch/stdout" 2> "$scratch/stderr"
status=$?
if [[ "$status" != 7 ]] || ! cmp -s "$TEST_COMMAND_LOG" <(printf '%s\0' develop "$project#profiling" -c bash "$project/build-support/profile-run" --seed 23); then
	printf 'FAIL: non-Linux benchmark preparation must use the same pinned shell without the Linux admission tool\n' >&2; exit 1
fi
printf 'PASS: non-Linux benchmark routing retains the pinned tools and failure status\n'
