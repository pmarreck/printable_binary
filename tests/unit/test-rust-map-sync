#!/usr/bin/env bash
# The self-contained crate must ship the exact repository mapping.
set -u
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)" || exit 1
if ! cmp -s "$repo_root/character_map.txt" "$repo_root/rust/character_map.txt"; then
	printf 'FAIL: rust/character_map.txt must match the canonical character_map.txt\n' >&2
	exit 1
fi
printf 'PASS: crate-local Rust mapping matches the canonical source\n'
