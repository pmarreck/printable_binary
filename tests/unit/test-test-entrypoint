#!/usr/bin/env bash
# The complete test entrypoint must run all Nix checks and propagate failures.
set -u

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
if [[ ! -f "$repo_root/test" || ! -x "$repo_root/test" ]]; then
	printf 'FAIL: ./test must be an executable file, not the old test directory\n' >&2
	exit 1
fi

scratch="$(mktemp -d)" || exit 1
trap 'rm -rf -- "$scratch"' EXIT
mkdir -p "$scratch/project with spaces" "$scratch/tools" || exit 1
cp "$repo_root/test" "$scratch/project with spaces/test" || exit 1
ln -s "$repo_root/tests/fixtures/record-build-command" "$scratch/tools/nix" || exit 1
export TEST_COMMAND_LOG="$scratch/arguments"
export PATH="$scratch/tools:$PATH"
failures=0

bash "$scratch/project with spaces/test" > "$scratch/stdout" 2> "$scratch/stderr"
status=$?
if [[ "$status" != 0 ]] || ! cmp -s "$TEST_COMMAND_LOG" <(printf '%s\0' flake check --keep-going --print-build-logs); then
	printf 'FAIL: ./test must run the complete accumulating Nix check graph\n' >&2
	failures=$((failures + 1))
fi
TEST_COMMAND_STATUS=7 bash "$scratch/project with spaces/test" > "$scratch/stdout" 2> "$scratch/stderr"
if [[ "$?" != 7 ]]; then
	printf 'FAIL: ./test must propagate a failing check graph\n' >&2
	failures=$((failures + 1))
fi
if [[ "$failures" == 0 ]]; then
	printf 'PASS: complete test entrypoint and failure propagation\n'
fi
exit "$failures"
