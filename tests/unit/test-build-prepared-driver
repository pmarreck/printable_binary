#!/usr/bin/env bash
# All three phases must run with exact arguments even if any selected phase fails.
set -u
if [[ -z "${NIX_BUILD_TOP:-}${TEST_WORKSPACE:-}" ]]; then exit 1; fi
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)" || exit 1
scratch="$(mktemp -d)" || exit 1
trap 'rm -rf -- "$scratch"' EXIT
project="$scratch/project with spaces"
mkdir -p "$project/tests/cli" "$project/tests/integration" || exit 1
cp "$repo_root/tests/cli/test-build-prepared" "$project/tests/cli/" || exit 1
cp "$repo_root/tests/cli/group-runner.bash" "$project/tests/cli/" || exit 1
for name in test-built-products test-built-profiles; do
	ln -s "$repo_root/tests/fixtures/build-phase-case" "$project/tests/integration/$name" || exit 1
done
ln -s "$repo_root/tests/fixtures/build-phase-case" "$project/tests/test_build_all" || exit 1
host_products="$scratch/host products" cross_products="$scratch/cross products"
canonical_products="$scratch/canonical products" profile_products="$scratch/profile products"
printf '%s\n' test-built-products test-built-profiles test_build_all > "$scratch/expected"
failures=0
for failed_phase in '' test_build_all test-built-products test-built-profiles; do
	export BUILD_PHASE_CALLS="$scratch/calls-${failed_phase:-none}"
	mkdir "$BUILD_PHASE_CALLS" || exit 1
	BUILD_PHASE_FAIL="$failed_phase" PB_TEST_JOBS=2 bash "$project/tests/cli/test-build-prepared" \
		"$host_products" "$cross_products" "$canonical_products" "$profile_products" > "$scratch/stdout" 2> "$scratch/stderr"
	status=$?
	if [[ ( -z "$failed_phase" && ( "$status" != 0 || -s "$scratch/stderr" ) ) ||
		( -n "$failed_phase" && ( "$status" == 0 || "$(<"$scratch/stderr")" != *"controlled $failed_phase failure"* ) ) ]] ||
		! cmp -s "$scratch/expected" <(LC_ALL=C ls "$BUILD_PHASE_CALLS"); then
		printf 'FAIL: prepared build phases lost work or status for %s\n' "${failed_phase:-positive control}" >&2
		failures=1
	fi
	if [[ ! -f "$BUILD_PHASE_CALLS/test_build_all" || -s "$BUILD_PHASE_CALLS/test_build_all" ]] ||
		! cmp -s "$BUILD_PHASE_CALLS/test-built-products" <(printf '%s\0' "$host_products" "$cross_products" "$canonical_products") ||
		! cmp -s "$BUILD_PHASE_CALLS/test-built-profiles" <(printf '%s\0' "$profile_products"); then failures=1; fi
done
[[ "$failures" == 0 ]] || exit 1
printf 'PASS: prepared build phases preserve all work, arguments and failures\n'
