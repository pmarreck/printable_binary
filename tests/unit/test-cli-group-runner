#!/usr/bin/env bash
# Exercise group completeness, limits, failures, output order and real overlap.
set -u
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
if [[ -z "${NIX_BUILD_TOP:-}${TEST_WORKSPACE:-}" ]]; then
	printf 'FAIL: run group-runner tests through ./test or run-isolated\n' >&2
	exit 1
fi
if [[ ! -f "$repo_root/tests/cli/group-runner.bash" ]]; then
	printf 'FAIL: shared CLI group runner is missing\n' >&2
	exit 1
fi
source "$repo_root/tests/cli/group-runner.bash"

if [[ "${1:-}" == --barrier ]]; then
	scratch="${2:?private barrier directory}"
	mkfifo "$scratch/started" || exit 1
	exec {started}<>"$scratch/started"
	for name in alpha beta gamma delta; do mkfifo "$scratch/release-$name" || exit 1; done
	barrier_group() {
		printf 'S\n' >> "$scratch/events"
		printf '%s\n' "$1" >&"$started"
		IFS= read -r release < "$scratch/release-$1" || return 1
		printf 'E\n' >> "$scratch/events"
	}
	pb_run_test_groups 2 "$scratch" barrier_group alpha beta gamma delta > "$scratch/stdout" 2> "$scratch/stderr" &
	pool=$!
	for wave in 1 2; do
		IFS= read -r -u "$started" first || exit 1
		IFS= read -r -u "$started" second || exit 1
		printf 'continue\n' > "$scratch/release-$first"
		printf 'continue\n' > "$scratch/release-$second"
	done
	wait "$pool" || exit 1
	awk '$0 == "S" {n++; starts++; if (n > maximum) maximum=n} $0 == "E" {n--; if (n < 0) bad=1} END {exit !(n == 0 && starts == 4 && maximum == 2 && !bad)}' "$scratch/events"
	exit "$?"
fi

scratch="$(mktemp -d)" || exit 1
trap 'rm -rf -- "$scratch"' EXIT
failures=0
probe_group() {
	printf '%s\n' "$1" >> "$scratch/calls"
	printf 'out-%s\n' "$1"
	printf 'err-%s\n' "$1" >&2
	[[ "$1" != "${failed_group:-}" ]]
}

for jobs in 1 2 3 4 5 6 7 8; do
	for failed_group in '' alpha beta gamma delta; do
		: > "$scratch/calls"
		pb_run_test_groups "$jobs" "$scratch" probe_group alpha beta gamma delta > "$scratch/stdout" 2> "$scratch/stderr"
		status=$?
		if [[ ( -z "$failed_group" && "$status" != 0 ) || ( -n "$failed_group" && "$status" == 0 ) ]] ||
			! cmp -s "$scratch/stdout" <(printf 'out-%s\n' alpha beta gamma delta) ||
			! cmp -s "$scratch/stderr" <(printf 'err-%s\n' alpha beta gamma delta) ||
			! cmp -s <(sort "$scratch/calls") <(printf '%s\n' alpha beta delta gamma); then
			printf 'FAIL: groups lost work, output order, or failure status at jobs=%s\n' "$jobs" >&2
			failures=$((failures + 1))
		fi
	done
done

for jobs in '' 0 -1 9 10 11 12 13 14 15 16 01 1x; do
	: > "$scratch/calls"
	pb_run_test_groups "$jobs" "$scratch" probe_group alpha beta > "$scratch/stdout" 2> "$scratch/stderr"
	if [[ "$?" == 0 || -s "$scratch/calls" ]]; then
		printf 'FAIL: invalid worker limit %q executed groups\n' "$jobs" >&2
		failures=$((failures + 1))
	fi
done
for bad_names in 'alpha alpha' 'alpha ../escape' ''; do
	read -r -a names <<< "$bad_names"
	: > "$scratch/calls"
	pb_run_test_groups 2 "$scratch" probe_group "${names[@]}" > "$scratch/stdout" 2> "$scratch/stderr"
	if [[ "$?" == 0 || -s "$scratch/calls" ]]; then
		printf 'FAIL: invalid or empty group set executed work\n' >&2
		failures=$((failures + 1))
	fi
done

mkdir "$scratch/barrier" || exit 1
# A deadlock guard, not a scheduling delay or a performance assertion. Neither
# worker can finish until the controller observes both starts and releases them.
if ! timeout 5 bash "${BASH_SOURCE[0]}" --barrier "$scratch/barrier" > "$scratch/stdout" 2> "$scratch/stderr"; then
	printf 'FAIL: two groups must overlap without exceeding the two-worker limit\n' >&2
	failures=$((failures + 1))
fi
[[ "$failures" == 0 ]] || exit 1
printf 'PASS: complete, bounded parallel CLI groups and deterministic output\n'
