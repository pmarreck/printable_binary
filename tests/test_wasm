#!/usr/bin/env bash
# Required WASM checks use an exact prepared launcher, never a stale PATH/module.
set -u
wasm_cli="${1:?Usage: test_wasm NIX_BUILT_WASM_LAUNCHER}"
if [[ ! -f "$wasm_cli" || ! -x "$wasm_cli" ]]; then
	printf 'FAIL: required WASM launcher is unavailable\n' >&2
	exit 1
fi
if [[ -z "${NIX_BUILD_TOP:-}${TEST_WORKSPACE:-}" ]]; then
	printf 'FAIL: run WASM tests through ./test or run-isolated\n' >&2
	exit 1
fi
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$repo_root/tests/capture.bash"
scratch="$(mktemp -d)" || exit 1
trap 'rm -rf -- "$scratch"' EXIT
failures=0
capture "$wasm_cli" --help
if [[ "$rc" != 0 || "$out$err" != *'Usage: printable-binary'* ]]; then
	printf 'FAIL: WASM help contract\n' >&2
	failures=$((failures + 1))
fi
printf 'Hello WASM!' > "$scratch/input"
capture env PRINTABLE_BINARY_MUTE_STATS= "$wasm_cli" < "$scratch/input"
if [[ "$rc" != 0 ]] || ! grep -Eq 'Input throughput: [0-9]+[.][0-9]{2} MB read in [0-9]+[.][0-9]{3} s \([0-9]+[.][0-9]{2} MB/s\)' <<< "$err"; then
	printf 'FAIL: WASM encode and stderr input-throughput contract\n' >&2
	failures=$((failures + 1))
fi
printf '%s' "$out" > "$scratch/encoded"
capture env PRINTABLE_BINARY_MUTE_STATS=1 "$wasm_cli" -d < "$scratch/encoded"
if [[ "$rc" != 0 || -n "$err" || "$out" != 'Hello WASM!' ]]; then
	printf 'FAIL: WASM exact decode and muted diagnostics\n' >&2
	failures=$((failures + 1))
fi
capture env PRINTABLE_BINARY_MUTE_STATS=1 "$wasm_cli" < "$scratch/input"
if [[ "$rc" != 0 || -n "$err" ]] || ! cmp -s <(printf '%s' "$out") "$scratch/encoded"; then
	printf 'FAIL: WASM exact encode and muted diagnostics\n' >&2
	failures=$((failures + 1))
fi
if [[ "$failures" == 0 ]]; then printf 'PASS: required WASM help, round trip, and statistics\n'; fi
exit "$failures"
