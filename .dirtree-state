# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
annotate=[
	.mechatron-prime/targets = Exact Nix package and check targets that Mechatron Prime builds from each pushed commit.
	CANONICAL_IMPL = Initial canonical executable implementation selection (Zig)
	MEMORIES/WASM benchmarks must stream inputs and APE needs a clean environment = WASI and Cosmopolitan runtime requirements for benchmark adapters.
	PLAN.md = Short actionable queue for build portability, deferred features, and explicit holds
	bm/benchmark-zig-opt = Benchmarks all available CLI variants, including Rust stdin, WASM, and APE adapters.
	build-all = One-way alias for all declared host implementations
	build-support/benchmark-products.bash = Resolve and verify exact optimized products for benchmark discovery
	build-support/build-driver = Run the build controller inside the pinned build environment
	build-support/canonical-package.nix = Expose the canonical command for a selected implementation product
	build-support/config.bash = Build selection, scope flags, and host platform normalization without invoking builders
	build-support/driver.bash = Select Nix products and verify complete builds before canonical publication
	build-support/implementations = Declared implementation, PF, ABI, compiler, Nix package, and command matrix
	build-support/matrix.bash = Validate build support rows and resolve implementation/platform scopes
	build-support/packages.nix = Build declared target and profile products through pinned language graphs
	build-support/publication.bash = Atomic retained product selection and host command publication
	build-support/source-filter.nix = Keep canonical selection outside individual product source closures
	docs/PLAN_LOG.md = Retired completed plan items and reconciled delivery history
	docs/plan_context/current-work.md = Retained decisions, build evidence, and explicit work holds
	docs/plans/2026-06-26-printable-binary-file-container-design.md = Design spec: printable-binary-file.json container + web decode workflow (issue #1)
	elixir/lib/printable_binary.ex = Elixir ~PB compile-time sigil: decodes printable-binary glyphs to raw bytes at compile time (reads character_map.txt via @external_resource); decode/1 runtime helper (whitespace-tolerant)
	elixir/mix.exs = Mix project for the ~PB sigil demo (no deps)
	elixir/test/printable_binary_test.exs = ExUnit tests + doctest for ~PB sigil / decode/1 (passthrough, control glyphs, whitespace-ignored heredoc, all-256 round-trip, unrecognized-glyph raise)
	flake.nix = Nix packages, checks, and development environment
	roc = Roc CLI, pure codecs, and contract tests
	roc/CliCore.roc = Pure CLI argument parser, transform routing, and range rules.
	roc/CliOutput.roc = Pure mapping table, JSON, and CSV renderers.
	roc/Codec.roc = Pure Roc byte codec with mapping-driven encode/decode.
	roc/Container.roc = Pure CRC and printable-binary-file container codec.
	roc/Map.roc = Generated Roc byte-to-glyph table from character_map.txt.
	roc/TestCliCore.roc = CLI core parser, transform, and range tests.
	roc/TestCliOutput.roc = Mapping output renderer tests.
	roc/TestCodec.roc = Roc codec unit expectations for mapping and whitespace behavior.
	roc/TestContainer.roc = Container integrity and transport-whitespace tests.
	roc/TestCrc.roc = CRC32 regression vectors.
	roc/TestMap.roc = Exhaustive Roc all-256 mapping round-trip expectations.
	roc/main.roc = Roc CLI adapter over pure codec and platform I/O.
	roc/platform-extension.patch = Roc platform file, clock, environment extension
	roc/platform.patch = Raw-byte Roc Zig platform patch
	run = Build and launch the exact canonical host command
	rust/build.rs = Codegens byte<->glyph map + O(1) decode tables from character_map.txt (single source)
	rust/examples/bench.rs = In-process Rust codec throughput bench (isolates codec from CLI I/O)
	rust/src/lib.rs = Rust printable-binary core: raw encode/decode + zero-alloc *_into (byte-identical to Zig, ~1.8x faster)
	rust/src/main.rs = Minimal Rust CLI (encode default, -d decode; stdin->stdout) for cross-impl verification
	src/container_json.h = Shared pure transport-resistant flat-JSON helpers for the .pbf.json container (C FFI + standalone C)
	src/zig/ffi.zig = C ABI (FFI) export surface: all 12 pb_* C functions; root of libprintable_binary.a; keeps C symbols OUT of the importable printable_binary module so static (musl) consumers don't collide
	src/zig/main.zig = Zig canonical CLI adapter with input-throughput status reporting and compact-map codec integration.
	src/zig/printable_binary.zig = Pure Zig codec core; default encode/decode use a portable 16-byte SIMD literal-prefix gate, padded encode slots, and compact direct UTF-8 decode tables.
	test = Complete test entrypoint for the accumulating Nix check graph
	tests/capture.bash = Hermetic stdout/stderr/status capture helper
	tests/fixtures/c-command = Harmless distinguishable C command for disposable publication tests
	tests/fixtures/record-build-command = Recording builder fixture with controlled exit status
	tests/fixtures/record-compiler = Record compiler arguments and create only the requested fixture product
	tests/fixtures/zig-command = Harmless distinguishable Zig command for disposable publication tests
	tests/integration/test-benchmark-products = Exercise benchmark product selection over every declared implementation/platform pair
	tests/integration/test-build-driver = Exercise scope selection, build failures, races, and canonical switching
	tests/integration/test-build-publication = Check atomic Unix and Windows publication with retry fault injection
	tests/integration/test-built-products = Verify installed codecs, canonical aliases, target headers, and real publication
	tests/integration/test-native-c-graph = Verify Make profile/prefix behavior and Nix command delegation
	tests/integration/test-output-ignore = Classify generated output and portable source paths using Git ignore rules
	tests/module_consumer.zig = Test fixture: minimal downstream importer of the printable_binary Zig module (mirrors how difz/blip consume it) for the FFI-symbol-leak test
	tests/nix/build-matrix-contract.nix = Validate exact Nix package/profile sets and canonical command selection
	tests/nix/source-filter-contract.nix = Check source inclusion over selector, current, and future file classes
	tests/test_build_all = Build selection, publication, product discovery, and one-way build-all alias checks
	tests/test_cli_layout = Nix-backed behavioral test for canonical Zig and retained LuaJIT executable names.
	tests/test_container = Container (.pbf.json) CLI round-trip + self-verify test, parameterized by IMPLEMENTATION_TO_TEST (issue #1)
	tests/test_container_cross = Cross-impl container differential: impl-A container decodes via impl-B (MFIC, issue #1)
	tests/test_cosmocc_host_tools = Reject Linux cosmocc build helpers that depend on MZ executable dispatch
	tests/test_docs_benchmark_contract = Guards implementation docs, mapping labels, benchmark inventory, and Mechatron CI manifest/badge contract.
	tests/test_module_no_ffi_symbols = Regression test (nm oracle): importing the module must emit 0 pb_* symbols while the FFI static lib keeps all 12 — guards the difz-blocking duplicate-symbol bug
	tests/test_roc = Roc full CLI and container contract runner
	tests/test_roc_map_sync = Roc mapping generator synchronization check
	tests/unit/test-build-config = Behavioral regressions for the build configuration core
	tests/unit/test-build-matrix = Assert complete support sets and namespaced product paths
	tests/unit/test-test-entrypoint = Records complete test invocation and verifies failure propagation
	utils/generate_roc_map.lua = Generates Roc map module from canonical mapping
]
