+/// Hosted function: Host.file_read_bytes!
+fn hostedFileReadBytes(path: abi.RocStr) callconv(.c) abi.HostFile_read_bytesResult {
+	const roc_host = g_roc_host.?;
+	var owned = path;
+	defer owned.decref(roc_host);
+
+	const io = std.Io.Threaded.global_single_threaded.io();
+	const roc_env: *abi.RocEnv = @ptrCast(@alignCast(roc_host.env));
+	const allocator = roc_env.allocator;
+	const input = std.Io.Dir.cwd().readFileAlloc(io, owned.asSlice(), allocator, .limited(std.math.maxInt(usize))) catch |err| return fileReadBytesErr(err, roc_host);
+	defer allocator.free(input);
+	return fileReadBytesOk(abi.RocListWith(u8, false).fromSlice(input, roc_host));
+}
