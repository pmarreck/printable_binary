+/// Hosted function: Host.clock_monotonic_nanoseconds!
+fn hostedClockMonotonicNanoseconds() callconv(.c) abi.HostClock_monotonic_nanosecondsResult {
+	const io = std.Io.Threaded.global_single_threaded.io();
+	const nanoseconds: u64 = @intCast(std.Io.Timestamp.now(io, .awake).toNanoseconds());
+	return clockMonotonicNanosecondsOk(nanoseconds);
+}
+
+/// Hosted function: Host.environment_stats_muted!
+fn hostedEnvironmentStatsMuted() callconv(.c) abi.HostEnvironment_stats_mutedResult {
+	const value = std.c.getenv("PRINTABLE_BINARY_MUTE_STATS") orelse return environmentStatsMutedOk(false);
+	const text = std.mem.span(value);
+	const muted = std.mem.eql(u8, text, "1") or std.ascii.eqlIgnoreCase(text, "true") or std.ascii.eqlIgnoreCase(text, "yes");
+	return environmentStatsMutedOk(muted);
+}
